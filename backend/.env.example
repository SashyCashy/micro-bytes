# Port the Flask app binds to locally. Open Food Facts and TheMealDB both need
# no API key, so there is nothing secret to set for a normal run.
PORT=5002

# Origins allowed to call the API: comma-separated, or "*" for any.
# Local development wants any; a deployed API should name its frontend.
CORS_ORIGINS=*

# Enables POST /api/assist (natural-language search). Without it that route
# returns 503 and the rest of the API is unaffected.
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
